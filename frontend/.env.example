# Copie para .env.local e ajuste. Sem .env.local, valem os padrões abaixo.

# URL base da API (padrão: http://localhost:8080)
VITE_API_URL=http://localhost:8080

# Número do WhatsApp da Rosie com DDI e DDD, só dígitos (ex.: 5511999999999).
# Vazio = o botão "Falar no WhatsApp" da Home fica sem link.
VITE_WHATSAPP_NUMERO=
