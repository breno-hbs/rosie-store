# Copie para .env.local e ajuste. Sem .env.local, valem os padrões abaixo.

# URL base da API (padrão: http://localhost:8080)
VITE_API_URL=http://localhost:8080

# Número do WhatsApp da Rosie: DDI 55 + DDD + número, só dígitos (ex.: 5511999999999).
# Vazio ou fora do formato = os botões do WhatsApp somem do site (na Home e na troca fica o Instagram no lugar).
# Fora do formato, o console do navegador avisa (no npm run dev e no modo demo). Também vale para o npm run demo.
VITE_WHATSAPP_NUMERO=
